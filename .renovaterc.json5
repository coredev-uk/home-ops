{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#11.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0",
    ":timezone(Europe/London)",
  ],
  // The Main ruleset does not require up-to-date branches, and `auto` would
  // rebase every open PR each time main moves
  rebaseWhen: "conflicted",
  customManagers: [
    {
      // The versions the T3 image (containers/t3/Containerfile) installs from release assets.
      // The build checks each download against the sums its release publishes, so Renovate only
      // bumps the version.
      customType: "regex",
      description: "T3 Code in the T3 image",
      managerFilePatterns: ["/^containers/t3/Containerfile$/"],
      matchStrings: ["ARG T3_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "pingdotgg/t3code",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "oh-my-pi (omp) in the T3 image",
      managerFilePatterns: ["/^containers/t3/Containerfile$/"],
      matchStrings: ["ARG OMP_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "can1357/oh-my-pi",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "Claude Code in the T3 image",
      managerFilePatterns: ["/^containers/t3/Containerfile$/"],
      matchStrings: ["ARG CLAUDE_CODE_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "@anthropic-ai/claude-code",
      datasourceTemplate: "npm",
    },
    {
      // The design skills baked into the T3 image: a tag and the commit the build
      // fetches, moved together. impeccable tags its skill releases skill-vX.Y.Z.
      customType: "regex",
      description: "impeccable skill in the T3 image",
      managerFilePatterns: ["/^containers/t3/Containerfile$/"],
      matchStrings: [
        "ARG IMPECCABLE_REF=(?<currentValue>skill-v[^@\\s]+)@(?<currentDigest>[0-9a-f]{40})",
      ],
      depNameTemplate: "pbakaus/impeccable",
      datasourceTemplate: "github-tags",
      versioningTemplate: "regex:^skill-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      customType: "regex",
      description: "taste-skill in the T3 image",
      managerFilePatterns: ["/^containers/t3/Containerfile$/"],
      matchStrings: [
        "ARG TASTE_SKILL_REF=(?<currentValue>v[^@\\s]+)@(?<currentDigest>[0-9a-f]{40})",
      ],
      depNameTemplate: "Leonxlnx/taste-skill",
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "Headscale on the Oracle VPS (deployed by `just oracle deploy`)",
      managerFilePatterns: ["/^oracle/mod\\.just$/"],
      matchStrings: ['headscale_version := "(?<currentValue>[^"]+)"'],
      depNameTemplate: "juanfont/headscale",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],
  // Bumps flake.lock (nixpkgs) for the dev shell's tools
  nix: {
    enabled: true,
    lockFileMaintenance: {
      enabled: true,
    },
  },
  // The dashboard issue, in Clarence's voice: Renovate finds updates, Clarence merges
  dependencyDashboardTitle: "📦 Renovate Dashboard",
  dependencyDashboardHeader: "## 📦 Renovate Dashboard\n\n> 📻 **Reporting in.** Every update Renovate found in this repository is below. Renovate only opens the pull requests: Clarence rules on each one and merges what its policy passes, one at a time, then checks the deploy. Tick a box to make Renovate act on the next run.\n\n| | |\n|---|---|\n| **Merged by** | Clarence (`kubernetes/apps/clarence`), see its card on each pull request |\n| **Release age** | minor and patch updates wait 3 days before Renovate opens them |\n| **Cluster report** | the `kind/report` issue |\n",
  dependencyDashboardFooter: "<sub>📻 Renovate · runs every two hours from `.github/workflows/renovate.yaml` · merges go through Clarence</sub>",
  // Renovate never merges: Clarence (kubernetes/apps/clarence) rules on every PR,
  // merges what its policy passes one at a time and checks each deploy.
  packageRules: [
    {
      // Only propose a minor or patch once it has been out for 3 days; Clarence also
      // reads upstream issues opened in that time for regressions
      description: "Let minor and patch releases settle",
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
      // Container registries publish no release timestamp: without this, Renovate holds
      // every image update as pending forever instead of proposing it.
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // Unites the factory installer image and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Keep CloudNativePG on Postgres 18 until the extension images move with it",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      allowedVersions: "/^18\\./",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
