{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#7.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#7.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#7.0.0",
    ":timezone(Europe/London)",
  ],
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // Changelog rules
    {
      description: "Use Frigate GitHub releases for changelogs",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/blakeblackshear/frigate"],
      sourceUrl: "https://github.com/blakeblackshear/frigate",
      changelogUrl: "https://github.com/blakeblackshear/frigate/releases",
    },
    {
      description: "Use Kometa GitHub releases for changelogs",
      matchDatasources: ["docker"],
      matchPackageNames: ["kometateam/kometa"],
      sourceUrl: "https://github.com/Kometa-Team/Kometa",
      changelogUrl: "https://github.com/Kometa-Team/Kometa/releases",
    },
    {
      // Reloader's chart releases are tagged "chart-v<version>" instead of "v<version>",
      // so Renovate can't match them against the chart version to pull release notes.
      description: "Fix changelog tag matching for Reloader Helm chart",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/stakater/charts/reloader"],
      extractVersion: "^(?:chart-v)?(?<version>.*)$",
    },
    {
      // prometheus-community/helm-charts is a monorepo where every chart's releases are
      // tagged "<chart-name>-<version>", so Renovate can't match tags to the chart version.
      // The image's org.opencontainers.image.source label also points at the upstream
      // blackbox_exporter binary repo instead of the chart repo, so sourceUrl needs pinning too.
      description: "Fix changelog source/tag matching for prometheus-blackbox-exporter Helm chart",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/prometheus-community/charts/prometheus-blackbox-exporter"],
      sourceUrl: "https://github.com/prometheus-community/helm-charts",
      extractVersion: "^(?:prometheus-blackbox-exporter-)?(?<version>.*)$",
    },
    {
      // Same monorepo tag-matching issue as prometheus-blackbox-exporter above.
      description: "Fix changelog tag matching for kube-prometheus-stack Helm chart",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/prometheus-community/charts/kube-prometheus-stack"],
      extractVersion: "^(?:kube-prometheus-stack-)?(?<version>.*)$",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
