# Hera TV, a Jellyfin plugin that gives the web client the Apple TV app's look (web/hera-tv.css)
# and behaviour (web/hera-tv.js), published by .github/workflows/jellyfin-hera-tv.yaml as
# ghcr.io/coredev-uk/jellyfin-hera-tv:<commit>.
#
# The image only carries the built plugin. Jellyfin's HelmRelease runs it as an init container
# that copies /plugin into /config/plugins/HeraTV, so the plugin version is whatever commit the
# HelmRelease pins, and the server never downloads it from a repository.
FROM mcr.microsoft.com/dotnet/sdk:11.0.100@sha256:65f3c7c6a25a239ab3e6719f2896147e7b68242ff2d8818dd70498bde6ef8bea AS build

WORKDIR /src
COPY Jellyfin.Plugin.HeraTv.csproj ./
RUN dotnet restore Jellyfin.Plugin.HeraTv.csproj
COPY . .
RUN dotnet publish Jellyfin.Plugin.HeraTv.csproj --no-restore -c Release -o /out -p:DebugType=none

FROM docker.io/library/busybox:1.37@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec

LABEL org.opencontainers.image.source="https://github.com/coredev-uk/home-ops"

COPY --from=build /out/Jellyfin.Plugin.HeraTv.dll /plugin/
COPY meta.json /plugin/
COPY web/Inter-LICENSE.txt /plugin/

USER 1000:1000
ENTRYPOINT ["sh", "-c", "rm -rf /config/plugins/HeraTV && mkdir -p /config/plugins/HeraTV && cp /plugin/* /config/plugins/HeraTV/"]
