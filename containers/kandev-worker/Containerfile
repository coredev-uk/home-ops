# The image Kandev's Kubernetes executor runs each task in (pod-template.yaml beside it), published
# by .github/workflows/kandev-worker.yaml as ghcr.io/coredev-uk/kandev-worker:<commit>.
#
# Kandev's universal image (Node, git, gh, Go, Rust, pnpm, build tools) plus single-user Nix and
# devenv: the repositories in ~/code bring their toolchains through flake.nix or devenv.nix
# (sona-go: GTK, GStreamer, sway for MyGo's headless tests), so one image serves them all and a
# repository's pins decide its tools. Kandev installs the agent CLIs (Claude Code's and Pi's ACP
# adapters) at launch, and injects agentctl, HOME (/run/kandev/home, memory-backed) and the
# workspace mount, whose root is the repository checkout. It also carries what oh-my-pi has on the
# operator's desktop and a task would otherwise lack: a session D-Bus, headless Chromium and the
# design skills (impeccable, taste-skill).
FROM ghcr.io/kdlbs/kandev:v0.101.0-universal@sha256:6d9b953529bf98bb233380e67957a9f11e357abc6bede1bdac162e08d5340f1e

LABEL org.opencontainers.image.source="https://github.com/coredev-uk/home-ops"

# Nix's release, its installer's hash (releases.nixos.org/nix/nix-<version>/install.sha256) and
# the nixpkgs commit devenv comes from (nixpkgs-unstable); sona-go needs devenv 2.4 or later.
ARG NIX_VERSION=2.34.9
ARG NIX_INSTALL_SHA256=a03ce2e9eaf4ea1560260b9a93e311dbaf589d28fb5c9318f8d9e768ee6339d8
ARG NIXPKGS_REV=13e53762c5afaf384d4614e94527a9ccfafe41d0

# The design skills, each a tag and its commit (the build fetches the commit; Renovate moves both:
# .renovaterc.json5). impeccable's engine binary is the release its VERSION names, checked
# against the engine-checksums.txt of the same commit.
ARG IMPECCABLE_REF=skill-v4.8.2@035c8f319edd019936525a062fe99e83ca8d12c6
ARG TASTE_SKILL_REF=v2.5.1@f6b76575f949707b4e3c37cd86cb44b0b98643e8

USER root

# The installer unpacks a .tar.xz. /nix belongs to the agent's user (UID 1000): one user, no
# daemon, so the store is written directly.
# sandbox: an unprivileged container has no user namespaces for Nix's build sandbox.
# chromium: taste-skill's checks drive headless Chrome over CDP (CHROME_PATH below). Debian's
# launcher reads /etc/chromium.d, where --no-sandbox is set: Chromium's own sandbox needs the user
# namespaces the pod does not have, and the pod (non-root, no capabilities, its network policy) is
# the boundary. fonts-liberation gives pages the metric-compatible core fonts.
# D-Bus: Nix's dbus-daemon reads /etc/dbus-1/session.conf, and libdbus clients need a machine ID,
# so dbus-run-session (sona-go's `tests` and `headless`) fails without both. One ID for the image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends xz-utils chromium fonts-liberation \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -m 0755 /nix /etc/nix \
 && chown 1000 /nix \
 && printf '%s\n' \
      'experimental-features = nix-command flakes' \
      'sandbox = false' \
      'build-users-group =' \
      'max-jobs = auto' \
      'extra-substituters = https://devenv.cachix.org' \
      'extra-trusted-public-keys = devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw=' \
      > /etc/nix/nix.conf \
 && install -d -o 1000 -g 1000 /var/cache/agent /opt/pi/agent \
 && printf '%s\n' '/.pi/mcp.json' '/.kandev/' > /etc/gitignore-agent \
 && git config --system core.excludesFile /etc/gitignore-agent \
 && git config --system --add safe.directory /workspace \
 && printf '%s\n' 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox"' > /etc/chromium.d/kandev-no-sandbox \
 && od -An -N16 -tx1 /dev/urandom | tr -d ' \n' > /etc/machine-id \
 && echo >> /etc/machine-id

# Lets Kandev's Create PR use the session's GitHub credentials: see the script.
COPY --chmod=0755 gh /usr/local/bin/gh

# The session bus configuration (see the file).
COPY dbus-session.conf /etc/dbus-1/session.conf

# The design skills, read-only at /opt/pi/skills (settings.json's skills): impeccable's Pi build
# with its engine at the path its launcher tries first, and taste-skill under its skill name.
RUN set -eu; \
    fetch() { \
      repo=$1; commit=${2#*@}; path=$3; dest=$4; \
      mkdir -p "$dest"; \
      curl -fsSL "https://codeload.github.com/$repo/tar.gz/$commit" \
        | tar -xz -C "$dest" --strip-components="$(echo "$path" | awk -F/ '{print NF + 1}')" \
            "${repo#*/}-$commit/$path"; \
    }; \
    fetch pbakaus/impeccable "$IMPECCABLE_REF" .pi/skills/impeccable /opt/pi/skills/impeccable; \
    fetch Leonxlnx/taste-skill "$TASTE_SKILL_REF" skills/taste-skill /opt/pi/skills/design-taste-frontend; \
    cd /opt/pi/skills/impeccable/scripts; \
    engine=$(cat VERSION); \
    sum=$(awk -v v="$engine" '$1 == v && $2 == "impeccable-linux-x64" { print $3 }' engine-checksums.txt); \
    test -n "$sum"; \
    mkdir -p bin/linux-x64; \
    curl -fsSL -o bin/linux-x64/impeccable \
      "https://github.com/pbakaus/impeccable/releases/download/engine-v${engine}/impeccable-linux-x64"; \
    echo "${sum}  bin/linux-x64/impeccable" | sha256sum -c -; \
    chmod 0755 bin/linux-x64/impeccable; \
    IMPECCABLE_NO_TELEMETRY=1 ./impeccable engine-probe; \
    grep -q '^name: impeccable$' /opt/pi/skills/impeccable/SKILL.md; \
    grep -q '^name: design-taste-frontend$' /opt/pi/skills/design-taste-frontend/SKILL.md; \
    chmod -R a+rX /opt/pi/skills

# Pi's agent directory (PI_CODING_AGENT_DIR below), so every task starts with these settings
# rather than an empty, memory-backed HOME:
# - settings.json: Claude through pi-claude-bridge (claude-bridge/claude-opus-5-5), which runs
#   Claude Code through the Agent SDK on Claude Code's own login. It also trusts the checkout
#   (RPC mode skips untrusted project resources, and Kandev delivers its MCP tools as
#   .pi/mcp.json), adds grep/find/ls plus Pi's built-in codemode and tool_search, loads the
#   skills Kandev writes to ~/.pi/agent/skills and the design skills in /opt/pi/skills (above),
#   retries through provider overloads, and lists
#   Pi's packages: the bridge and the tools oh-my-pi ships with, pi-subagents (delegation and
#   multi-agent workflows), rpiv-todo (a todo list, with its rpiv-i18n dependency),
#   pi-web-access (web search and fetch; Exa needs no key) and pi-lens (LSP, linters, type
#   checks, ast-grep). The packages are installed below, so a task pod does not fetch 250MB on
#   start. settings.json is their only list: Renovate bumps it, and the build derives the rest.
#   Its subagents block runs children on Sonnet (scout on Haiku, oracle on the parent's Opus).
# - extensions/subagent/config.json: pi-subagents offers `subagent` from the first request (the
#   claude-bridge fixes the tool list per prompt, so enabling it mid-turn would only take effect
#   on a next prompt an unattended task never gets), puts worktrees in the writable layer (the
#   default sits beside the checkout, at /worktrees) and runs at most three children at once.
# - AGENTS.md: what the pod is and how to work in it, for every repository.
# Pi writes its sessions and trust.json here too: the pod's writable layer, kept across Stop.
COPY --chown=1000:1000 pi/ /opt/pi/agent/

USER kandev

# Installs settings.json's packages the way Pi does on start: into <agent dir>/npm, without
# their peers (the peers are Pi itself). pi-packages.mjs writes that directory's package.json.
COPY --chown=1000:1000 pi-packages.mjs /tmp/pi-packages.mjs
RUN node /tmp/pi-packages.mjs /opt/pi/agent \
 && cd /opt/pi/agent/npm \
 && npm_config_cache=/tmp/npm-cache npm install --legacy-peer-deps --no-audit --no-fund \
 && rm -rf /tmp/npm-cache /tmp/pi-packages.mjs

# HOME during the build is a scratch directory: the base image's /data is a VOLUME, and Kandev
# gives tasks their own HOME. Nix and devenv go into a profile under /nix that PATH names, so
# nothing depends on the build's HOME.
RUN set -eu; \
    export HOME=/tmp/nix-build-home; \
    mkdir -p "$HOME"; \
    curl -fsSL "https://releases.nixos.org/nix/nix-${NIX_VERSION}/install" -o /tmp/install-nix; \
    echo "${NIX_INSTALL_SHA256}  /tmp/install-nix" | sha256sum -c -; \
    sh /tmp/install-nix --no-daemon --no-channel-add --no-modify-profile; \
    "$HOME/.nix-profile/bin/nix" profile add --profile /nix/var/nix/profiles/agent \
      "github:NixOS/nixpkgs/${NIXPKGS_REV}#nix" \
      "github:NixOS/nixpkgs/${NIXPKGS_REV}#devenv"; \
    rm -rf "$HOME" /tmp/install-nix; \
    /nix/var/nix/profiles/agent/bin/nix-collect-garbage --quiet; \
    /nix/var/nix/profiles/agent/bin/nix --version; \
    /nix/var/nix/profiles/agent/bin/devenv version

# Caches go to the pod's writable layer (ephemeral storage, kept across Stop), not the
# memory-backed HOME and not /workspace: its root is the checkout, where they would show up as
# untracked files an agent could commit.
# Pi: PI_SKIP_VERSION_CHECK keeps "new version" notices out of the chat (Kandev pins pi-acp),
# and PI_CACHE_RETENTION=long asks for Anthropic's one-hour prompt cache, which outlives the
# pauses while a task waits for review.
# The design skills: taste-skill finds Chromium through CHROME_PATH, and impeccable's engine
# sends no telemetry.
ENV PATH=/nix/var/nix/profiles/agent/bin:$PATH \
    XDG_CACHE_HOME=/var/cache/agent/xdg \
    XDG_DATA_HOME=/var/cache/agent/share \
    XDG_STATE_HOME=/var/cache/agent/state \
    GOCACHE=/var/cache/agent/go-build \
    GOMODCACHE=/var/cache/agent/go-mod \
    CARGO_HOME=/var/cache/agent/cargo \
    npm_config_cache=/var/cache/agent/npm \
    npm_config_store_dir=/var/cache/agent/pnpm-store \
    PI_CODING_AGENT_DIR=/opt/pi/agent \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    PI_CACHE_RETENTION=long \
    PI_LENS_HOME=/var/cache/agent/pi-lens \
    CHROME_PATH=/usr/bin/chromium \
    IMPECCABLE_NO_TELEMETRY=1

WORKDIR /workspace
ENTRYPOINT []
CMD ["sleep", "infinity"]
