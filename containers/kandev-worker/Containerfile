# The image Kandev's Kubernetes executor runs each task in (pod-template.yaml beside it), published
# by .github/workflows/kandev-worker.yaml as ghcr.io/coredev-uk/kandev-worker:<commit>.
#
# Kandev's universal image (Node, git, gh, Go, Rust, pnpm, build tools) plus single-user Nix and
# devenv: the repositories in ~/code bring their toolchains through flake.nix or devenv.nix
# (sona-go: GTK, GStreamer, sway for MyGo's headless tests), so one image serves them all and a
# repository's pins decide its tools. Kandev installs the agent CLIs (Claude Code's and Pi's ACP
# adapters) at launch, and injects agentctl, HOME (/run/kandev/home, memory-backed) and the
# workspace mount, whose root is the repository checkout.
FROM ghcr.io/kdlbs/kandev:v0.99.1-universal@sha256:b0873f1e9881ac2dd3b35f81c3c3e98a93fa0025e88f54460bf079b7a76f8450

LABEL org.opencontainers.image.source="https://github.com/coredev-uk/home-ops"

# Nix's release, its installer's hash (releases.nixos.org/nix/nix-<version>/install.sha256) and
# the nixpkgs commit devenv comes from (nixpkgs-unstable); sona-go needs devenv 2.4 or later.
ARG NIX_VERSION=2.34.9
ARG NIX_INSTALL_SHA256=a03ce2e9eaf4ea1560260b9a93e311dbaf589d28fb5c9318f8d9e768ee6339d8
ARG NIXPKGS_REV=13e53762c5afaf384d4614e94527a9ccfafe41d0

USER root

# The installer unpacks a .tar.xz. /nix belongs to the agent's user (UID 1000): one user, no
# daemon, so the store is written directly.
# sandbox: an unprivileged container has no user namespaces for Nix's build sandbox.
RUN apt-get update \
 && apt-get install -y --no-install-recommends xz-utils \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -m 0755 /nix /etc/nix \
 && chown 1000 /nix \
 && printf '%s\n' \
      'experimental-features = nix-command flakes' \
      'sandbox = false' \
      'build-users-group =' \
      'max-jobs = auto' \
      'extra-substituters = https://devenv.cachix.org' \
      'extra-trusted-public-keys = devenv.cachix.org-1:w1cLUi8dv3hnoSPGAuibQv+f9TZLr6cv/Hm9XgU50cw=' \
      > /etc/nix/nix.conf \
 && install -d -o 1000 -g 1000 /var/cache/agent /opt/pi/agent \
 && printf '%s\n' '/.pi/mcp.json' '/.kandev/' > /etc/gitignore-agent \
 && git config --system core.excludesFile /etc/gitignore-agent

# Pi's agent directory (PI_CODING_AGENT_DIR below), so every task starts with these settings
# rather than an empty, memory-backed HOME:
# - settings.json: trusts the checkout (RPC mode skips untrusted project resources, and Kandev
#   delivers its MCP tools as .pi/mcp.json), adds grep/find/ls plus Pi's built-in codemode and
#   tool_search, loads the skills Kandev writes to ~/.pi/agent/skills, retries through provider
#   overloads, and lists Pi's packages: the tools oh-my-pi ships with, pi-subagents (delegation
#   and multi-agent workflows), rpiv-todo (a todo list, with its rpiv-i18n dependency),
#   pi-web-access (web search and fetch; Exa needs no key) and pi-lens (LSP, linters, type
#   checks, ast-grep). The packages are installed below, so a task pod does not fetch 250MB on
#   start. settings.json is their only list: Renovate bumps it, and the build derives the rest.
# - AGENTS.md: what the pod is and how to work in it, for every repository.
# - mcp.json: Kandev's MCP tools (task title, plan, questions) from the agentctl instance in this
#   pod. Kandev only writes .pi/mcp.json when it knows a standalone agentctl port, which a
#   Kubernetes task has none of ("skipping project MCP config: agentctl instance port
#   unavailable"). A pod runs one instance, on AGENTCTL_INSTANCE_PORT_BASE (41001). A project
#   .pi/mcp.json, when Kandev writes one, overrides this entry.
# - auth.json: Anthropic's key from PI_ANTHROPIC_API_KEY when an executor profile sets one;
#   without it Pi uses ANTHROPIC_OAUTH_TOKEN, the Claude login (billed as extra usage).
# Pi writes its sessions and trust.json here too: the pod's writable layer, kept across Stop.
COPY --chown=1000:1000 pi/ /opt/pi/agent/
RUN chmod 0600 /opt/pi/agent/auth.json

USER kandev

# Installs settings.json's packages the way Pi does on start: into <agent dir>/npm, without
# their peers (the peers are Pi itself). pi-packages.mjs writes that directory's package.json.
COPY --chown=1000:1000 pi-packages.mjs /tmp/pi-packages.mjs
RUN node /tmp/pi-packages.mjs /opt/pi/agent \
 && cd /opt/pi/agent/npm \
 && npm_config_cache=/tmp/npm-cache npm install --legacy-peer-deps --no-audit --no-fund \
 && rm -rf /tmp/npm-cache /tmp/pi-packages.mjs

# HOME during the build is a scratch directory: the base image's /data is a VOLUME, and Kandev
# gives tasks their own HOME. Nix and devenv go into a profile under /nix that PATH names, so
# nothing depends on the build's HOME.
RUN set -eu; \
    export HOME=/tmp/nix-build-home; \
    mkdir -p "$HOME"; \
    curl -fsSL "https://releases.nixos.org/nix/nix-${NIX_VERSION}/install" -o /tmp/install-nix; \
    echo "${NIX_INSTALL_SHA256}  /tmp/install-nix" | sha256sum -c -; \
    sh /tmp/install-nix --no-daemon --no-channel-add --no-modify-profile; \
    "$HOME/.nix-profile/bin/nix" profile add --profile /nix/var/nix/profiles/agent \
      "github:NixOS/nixpkgs/${NIXPKGS_REV}#nix" \
      "github:NixOS/nixpkgs/${NIXPKGS_REV}#devenv"; \
    rm -rf "$HOME" /tmp/install-nix; \
    /nix/var/nix/profiles/agent/bin/nix-collect-garbage --quiet; \
    /nix/var/nix/profiles/agent/bin/nix --version; \
    /nix/var/nix/profiles/agent/bin/devenv version

# Caches go to the pod's writable layer (ephemeral storage, kept across Stop), not the
# memory-backed HOME and not /workspace: its root is the checkout, where they would show up as
# untracked files an agent could commit.
# Pi: PI_SKIP_VERSION_CHECK keeps "new version" notices out of the chat (Kandev pins pi-acp),
# and PI_CACHE_RETENTION=long asks for Anthropic's one-hour prompt cache, which outlives the
# pauses while a task waits for review.
ENV PATH=/nix/var/nix/profiles/agent/bin:$PATH \
    XDG_CACHE_HOME=/var/cache/agent/xdg \
    XDG_DATA_HOME=/var/cache/agent/share \
    XDG_STATE_HOME=/var/cache/agent/state \
    GOCACHE=/var/cache/agent/go-build \
    GOMODCACHE=/var/cache/agent/go-mod \
    CARGO_HOME=/var/cache/agent/cargo \
    npm_config_cache=/var/cache/agent/npm \
    npm_config_store_dir=/var/cache/agent/pnpm-store \
    PI_CODING_AGENT_DIR=/opt/pi/agent \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    PI_CACHE_RETENTION=long \
    PI_LENS_HOME=/var/cache/agent/pi-lens

WORKDIR /workspace
ENTRYPOINT []
CMD ["sleep", "infinity"]
