#!/bin/sh
# The gh on PATH ahead of Debian's /usr/bin/gh (Containerfile). Kandev's managed Git credentials
# give each task session a gh shim (agentctl, in $KANDEV_GITHUB_CLI_SHIM_DIR) that redeems the
# session's broker lease for a token. Kandev puts that directory on the agent's PATH, but agentctl
# runs Create PR's `gh pr create` by name from its own process, whose PATH lacks it, so the real
# gh ran unauthenticated ("HTTP 401: Requires authentication"). Without a token, hand gh to the
# shim; it runs the real gh with GH_TOKEN set, which reaches this script again and goes straight
# through.
if [ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]; then
  shim_dir=${KANDEV_GITHUB_CLI_SHIM_DIR:-}
  if [ -z "$shim_dir" ]; then
    old_ifs=$IFS
    IFS=:
    for dir in $PATH; do
      case ${dir##*/} in
        kandev-github-cli-*) shim_dir=$dir && break ;;
      esac
    done
    IFS=$old_ifs
  fi
  if [ -n "$shim_dir" ] && [ -x "$shim_dir/gh" ]; then
    exec "$shim_dir/gh" "$@"
  fi
fi
exec /usr/bin/gh "$@"
