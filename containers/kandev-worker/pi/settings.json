{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "always",
  "defaultTools": ["+grep", "+find", "+ls", "+codemode", "+tool_search"],
  "skills": ["~/.pi/agent/skills"],
  "packages": [
    "npm:pi-claude-bridge@0.10.0",
    "npm:pi-subagents@0.85.0",
    "npm:@juicesharp/rpiv-i18n@2.15.0",
    "npm:@juicesharp/rpiv-todo@2.15.0",
    "npm:pi-web-access@0.47.0",
    "npm:pi-lens@4.4.9"
  ],
  "quietStartup": true,
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "retry": {
    "maxRetries": 8,
    "maxAgentDelayMs": 120000
  }
}
