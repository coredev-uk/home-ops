#!/usr/bin/env bash
# Git credential helper (`credential.https://github.com.helper cliffe`, set in the Containerfile)
# and the token source for the gh wrapper beside it (containers/t3/gh). It mints a GitHub App
# installation token for bot-cliffe from GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID and
# GITHUB_APP_PRIVATE_KEY (the t3-secret Secret), because T3 has no token broker and an
# installation token expires after an hour, so a static GH_TOKEN would go stale in a long-lived pod.
#
# Usage: git-credential-cliffe get|store|erase   (git's protocol; only `get` does anything)
#        git-credential-cliffe token             (print a valid token; used by gh)
#
# The token is cached in a 0600 file until five minutes before it expires, so the many git
# invocations of one thread share a single API call.
set -euo pipefail

cache="${XDG_RUNTIME_DIR:-/tmp}/cliffe-github-token-$(id -u)"
margin=300

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

mint() {
  local now header payload unsigned signature jwt response token expires_at
  now=$(date +%s)
  header=$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)
  # GitHub rejects a JWT issued in its future, so back-date by a minute against clock skew.
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$GITHUB_APP_ID" | b64url)
  unsigned="${header}.${payload}"
  signature=$(printf '%s' "$unsigned" \
    | openssl dgst -sha256 -sign <(printf '%s\n' "$GITHUB_APP_PRIVATE_KEY") -binary \
    | b64url)
  jwt="${unsigned}.${signature}"
  response=$(curl -fsS -X POST \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/${GITHUB_APP_INSTALLATION_ID}/access_tokens")
  token=$(jq -er '.token' <<<"$response")
  expires_at=$(date -d "$(jq -er '.expires_at' <<<"$response")" +%s)
  (
    umask 077
    printf '%s\n%s\n' "$expires_at" "$token" > "${cache}.$$"
  )
  mv -f "${cache}.$$" "$cache"
  printf '%s\n' "$token"
}

token() {
  local expires_at cached
  if [[ -r "$cache" ]]; then
    { read -r expires_at && read -r cached; } < "$cache" || true
    if [[ -n "${cached:-}" && "${expires_at:-0}" -gt $(($(date +%s) + margin)) ]]; then
      printf '%s\n' "$cached"
      return
    fi
  fi
  mint
}

case "${1:-}" in
  get)
    protocol='' host=''
    while IFS='=' read -r key value; do
      [[ -z "$key" ]] && break
      case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
      esac
    done
    if [[ "$protocol" == https && "$host" == github.com ]]; then
      printf 'username=x-access-token\npassword=%s\n' "$(token)"
    fi
    ;;
  token) token ;;
  store | erase) ;;
  *)
    echo "usage: git-credential-cliffe get|store|erase|token" >&2
    exit 2
    ;;
esac
