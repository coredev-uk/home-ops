{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Attic at attic.hera.ac: what the coredev cache holds, what it serves, and its pod.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 14,
      "type": "row",
      "title": "Cache",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Store Paths",
      "description": "Store paths the cache holds (only what no public cache has).",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_objects)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Uncompressed Size",
      "description": "NAR size of everything in the cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_nar_bytes)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Stored",
      "description": "Compressed, deduplicated chunks on the NAS share NixCache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_storage_stored_bytes)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Space Saving",
      "description": "Uncompressed size over stored size: zstd plus chunk deduplication.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "x",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_nar_bytes) / max(cnpg_nix_cache_storage_stored_bytes)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Last Push",
      "description": "Time since a new store path arrived in the cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 172800
              },
              {
                "color": "red",
                "value": 604800
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "time() - max(cnpg_nix_cache_last_push_timestamp_seconds)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Paths Fetched (24h)",
      "description": "Store paths the hosts and CI downloaded from the cache in the last day.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_objects_accessed_24h)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Cache Size",
      "description": "Uncompressed size of the cached paths and what they take on disk. Paths nobody fetched for 30 days are garbage-collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_nar_bytes)",
          "refId": "A",
          "legendFormat": "uncompressed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_storage_stored_bytes)",
          "refId": "B",
          "legendFormat": "stored"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Store Paths",
      "description": "Store paths in the cache over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_nix_cache_objects)",
          "refId": "A",
          "legendFormat": "paths"
        }
      ]
    },
    {
      "id": 23,
      "type": "row",
      "title": "Serving",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Requests by Status",
      "description": "Requests through envoy-external: substitutions by the hosts and CI, and CI's pushes. A 404 is a path the cache does not have, which Nix then asks the next cache for.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum by (envoy_response_code_class) (rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"httproute/nix-cache/attic/.+\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{envoy_response_code_class}}xx"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Bytes Served",
      "description": "Bytes the hosts and CI downloaded from the cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(envoy_cluster_upstream_cx_rx_bytes_total{envoy_cluster_name=~\"httproute/nix-cache/attic/.+\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "served"
        }
      ]
    },
    {
      "id": 26,
      "type": "row",
      "title": "Resources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Attic Memory",
      "description": "Working set of the Attic pod's containers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (container) (container_memory_working_set_bytes{namespace=\"nix-cache\", pod=~\"attic-.+\", pod!~\"attic-postgres-.+\", container!=\"\"})",
          "refId": "A",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Attic Database",
      "description": "Used space against capacity on attic-postgres's volume (backed up by kopiur). The chunks live on the NAS.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"nix-cache\", persistentvolumeclaim=\"attic-postgres-1\"})",
          "refId": "A",
          "legendFormat": "{{persistentvolumeclaim}} used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{namespace=\"nix-cache\", persistentvolumeclaim=\"attic-postgres-1\"})",
          "refId": "B",
          "legendFormat": "{{persistentvolumeclaim}} capacity"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 40,
  "tags": ["infrastructure", "nix", "cache"],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "label": "Prometheus",
        "multi": false,
        "name": "promDatasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Nix Cache",
  "uid": "nix-cache"
}
