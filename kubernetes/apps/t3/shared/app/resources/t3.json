      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Environments by node",
      "description": "The node each environment's pod runs on. A required anti-affinity keeps the two on different nodes; t3-a prefers hyperion-0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "count by (node, pod) (kube_pod_info{namespace=\"t3\", pod=~\"($environment)-.*\", node!=\"\"})",
          "legendFormat": "{{pod}} on {{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Ephemeral storage",
      "description": "Ephemeral storage each server container uses (the Nix store, the writable layer and the emptyDir caches) against its limit. Exceeding the limit evicts the pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (pod) (container_fs_usage_bytes{namespace=\"t3\", pod=~\"($environment)-.*\", container=\"app\"})",
          "legendFormat": "{{pod}} used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"t3\", pod=~\"($environment)-.*\", container=\"app\", resource=\"ephemeral_storage\"})",
          "legendFormat": "{{pod}} limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
