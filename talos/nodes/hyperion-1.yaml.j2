---
machine:
  type: controlplane
  install:
    diskSelector:
      serial: P300NDBB2510091860
  kubelet:
    extraConfig:
      # Tighter than the cluster default (70/60): this node is taking over the
      # 128GB drive, which already holds >100GB of unpruned image layers on the
      # 256GB drive it's leaving behind.
      imageGCHighThresholdPercent: 60
      imageGCLowThresholdPercent: 50
  nodeLabels:
    topology.kubernetes.io/zone: m
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: hyperion-1
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: mac(link.permanent_addr) == "f8:75:a4:e8:17:3a"
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 192.168.110.29
link: net0
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: net0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: net0.3
vlanID: 3
vlanMode: 802.1q
parent: net0
up: true
addresses:
  - address: 192.168.120.241/24
