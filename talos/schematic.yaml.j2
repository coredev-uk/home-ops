---
customization:
  extraKernelArgs:
    - -selinux # Drop the default selinux=1
    - audit=0 # Disable kernel audit
    - i915.enable_guc=3 # Meteor Lake CPU & Intel iGPU
    - intel_iommu=on # PCI Passthrough
    - iommu=pt # PCI Passthrough
    - selinux=0 # Disable SELinux
    - sysctl.kernel.kexec_load_disabled=1 # Meteor Lake CPU & Intel iGPU
    - talos.auditd.disabled=1 # Disable Talos auditd (nothing to read with audit=0)
  systemExtensions:
    officialExtensions:
      - siderolabs/i915 # Intel iGPU
      - siderolabs/intel-ucode # Intel iGPU
      - siderolabs/kata-containers # VM-isolated pods (RuntimeClass kata)
      - siderolabs/mei # Intel iGPU
      - siderolabs/nfsrahead # NFS Readahead
      - siderolabs/tailscale # Remote access (Headscale subnet router)
